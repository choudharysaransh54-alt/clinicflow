# ------------------------------------------------------------------------------
# CLINICFLOW - SERVER CONFIGURATION
# ------------------------------------------------------------------------------

# MongoDB Configuration (already running via Docker on port 27018)
MONGO_URI=mongodb://localhost:27018/clinicflow

# Redis Configuration (already running via Docker on port 6379)
REDIS_URL=redis://localhost:6379

# Server Port
PORT=3001

# ------------------------------------------------------------------------------
# TWILIO SMS CONFIGURATION (For Live Text Messages)
# ------------------------------------------------------------------------------
# 1. Go to https://www.twilio.com/ and create a free account
# 2. Get a free trial phone number
# 3. Copy your Account SID, Auth Token, and Twilio Phone Number here:

# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890

# Note: Once you uncomment the Twilio lines above and restart the backend,
# the SmsService will automatically switch from MOCK mode to LIVE mode!
